<Window x:Class="ModelPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Peek"
        Width="1180"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D21"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="Assets/ModelPeek.ico"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid x:Name="ViewerSurface"
              Background="#1B1D21"
              MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
              MouseRightButtonDown="Viewer_MouseRightButtonDown"
              MouseDown="Viewer_MouseDown"
              MouseMove="Viewer_MouseMove"
              MouseUp="Viewer_MouseUp"
              MouseWheel="Viewer_MouseWheel"
              MouseLeave="Viewer_MouseLeave">
            <Viewport3D x:Name="Viewport" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera"
                                       FieldOfView="38"
                                       Position="100,-100,75"
                                       LookDirection="-100,100,-75"
                                       UpDirection="0,0,1" />
                </Viewport3D.Camera>
            </Viewport3D>

            <Grid x:Name="EmptyState" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="Assets/ModelPeek.png"
                           Width="112"
                           Height="112"
                           Margin="0,0,0,20" />
                    <TextBlock Text="M O D E L   P E E K"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontFamily="Segoe UI Semibold"
                               FontSize="20" />
                    <TextBlock Text="Drop an STL here, or open one to take a look."
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border VerticalAlignment="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#35383E"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Open STL"
                        Click="OpenButton_Click"
                        ToolTip="Open an STL file (Ctrl+O)" />

                <StackPanel Grid.Column="1"
                            Margin="14,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               Text="No model open"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13" />
                    <TextBlock x:Name="FileInfoText"
                               Text="Read-only STL viewer"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="FitButton"
                            Content="Fit"
                            Click="FitButton_Click"
                            IsEnabled="False"
                            ToolTip="Fit the whole model in view (F)" />
                    <Button x:Name="IsoButton"
                            Content="Iso"
                            Click="IsoButton_Click"
                            IsEnabled="False"
                            ToolTip="Isometric view (1)" />
                    <Button x:Name="FrontButton"
                            Content="Front"
                            Click="FrontButton_Click"
                            IsEnabled="False"
                            ToolTip="Front view (2)" />
                    <Button x:Name="TopButton"
                            Content="Top"
                            Click="TopButton_Click"
                            IsEnabled="False"
                            ToolTip="Top view (3)" />
                    <Button x:Name="RightButton"
                            Content="Right"
                            Click="RightButton_Click"
                            IsEnabled="False"
                            ToolTip="Right view (4)" />
                </StackPanel>
            </Grid>
        </Border>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="12,8"
                IsHitTestVisible="False">
            <TextBlock x:Name="HelpText"
                       Text="Left drag: rotate   •   Right drag: pan   •   Wheel: zoom"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11" />
        </Border>

        <Border x:Name="LoadingOverlay"
                Visibility="Collapsed"
                Background="#B3191B1F"
                IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#35383E" />
                <TextBlock x:Name="LoadingText"
                           Text="Opening model…"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,16,0,0"
                           FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
