<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModelPeek</AssemblyName>
    <RootNamespace>ModelPeek</RootNamespace>
    <ApplicationIcon>Assets\ModelPeek.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>0.1.0</Version>
    <Authors>Model Peek contributors</Authors>
    <Company>Model Peek contributors</Company>
    <Copyright>Copyright (c) 2026 Model Peek contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>Model Peek</Product>
    <AssemblyTitle>Model Peek</AssemblyTitle>
    <Description>A fast, read-only STL viewer for Windows.</Description>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);release-source\**;installer\**;publish\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ModelPeek.ico" />
    <Resource Include="Assets\ModelPeek.png" />
  </ItemGroup>
</Project>
